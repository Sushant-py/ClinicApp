<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#3F51B5"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nasal Symptom Score"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etPatientId"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Patient/Trial ID"
                android:background="#FFFFFF"
                android:padding="8dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etPatientName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Patient Name (Read-only)"
                android:inputType="textPersonName"
                android:background="#F0F0F0"
                android:focusable="false"
                android:padding="8dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etAssessmentDate"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="@string/assessment_date"
                android:focusable="false"
                android:clickable="true"
                android:background="#FFFFFF"
                android:padding="8dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etAssessmentTime"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="@string/assessment_time"
                android:focusable="false"
                android:clickable="true"
                android:background="#FFFFFF"
                android:padding="8dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/select_assessment_visit"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spinVisitInterval"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="16dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Nasal Congestion/Stuffiness"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                    <RadioGroup
                        android:id="@+id/rgCongestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RadioButton android:id="@+id/rbCongestion0" android:text="0 - None"/>
                        <RadioButton android:id="@+id/rbCongestion1" android:text="1 - Mild"/>
                        <RadioButton android:id="@+id/rbCongestion2" android:text="2 - Moderate"/>
                        <RadioButton android:id="@+id/rbCongestion3" android:text="3 - Severe"/>
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. Rhinorrhea (Runny Nose)"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                    <RadioGroup
                        android:id="@+id/rgRhinorrhea"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RadioButton android:id="@+id/rbRhinorrhea0" android:text="0 - None"/>
                        <RadioButton android:id="@+id/rbRhinorrhea1" android:text="1 - Mild"/>
                        <RadioButton android:id="@+id/rbRhinorrhea2" android:text="2 - Moderate"/>
                        <RadioButton android:id="@+id/rbRhinorrhea3" android:text="3 - Severe"/>
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3. Sneezing"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                    <RadioGroup
                        android:id="@+id/rgSneezing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RadioButton android:id="@+id/rbSneezing0" android:text="0 - None"/>
                        <RadioButton android:id="@+id/rbSneezing1" android:text="1 - Mild"/>
                        <RadioButton android:id="@+id/rbSneezing2" android:text="2 - Moderate"/>
                        <RadioButton android:id="@+id/rbSneezing3" android:text="3 - Severe"/>
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4. Nasal Itching"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                    <RadioGroup
                        android:id="@+id/rgItching"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RadioButton android:id="@+id/rbItching0" android:text="0 - None"/>
                        <RadioButton android:id="@+id/rbItching1" android:text="1 - Mild"/>
                        <RadioButton android:id="@+id/rbItching2" android:text="2 - Moderate"/>
                        <RadioButton android:id="@+id/rbItching3" android:text="3 - Severe"/>
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5. Post-Nasal Drip"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                    <RadioGroup
                        android:id="@+id/rgPostNasal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RadioButton android:id="@+id/rbPostNasal0" android:text="0 - None"/>
                        <RadioButton android:id="@+id/rbPostNasal1" android:text="1 - Mild"/>
                        <RadioButton android:id="@+id/rbPostNasal2" android:text="2 - Moderate"/>
                        <RadioButton android:id="@+id/rbPostNasal3" android:text="3 - Severe"/>
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Additional Symptoms (Optional Assessment)"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:textColor="#555555"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6. Loss of Smell (Hyposmia/Anosmia)"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                    <RadioGroup
                        android:id="@+id/rgSmell"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RadioButton android:id="@+id/rbSmell0" android:text="0 - None"/>
                        <RadioButton android:id="@+id/rbSmell1" android:text="1 - Mild"/>
                        <RadioButton android:id="@+id/rbSmell2" android:text="2 - Moderate"/>
                        <RadioButton android:id="@+id/rbSmell3" android:text="3 - Severe"/>
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7. Eye Symptoms"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                    <RadioGroup
                        android:id="@+id/rgEye"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RadioButton android:id="@+id/rbEye0" android:text="0 - None"/>
                        <RadioButton android:id="@+id/rbEye1" android:text="1 - Mild"/>
                        <RadioButton android:id="@+id/rbEye2" android:text="2 - Moderate"/>
                        <RadioButton android:id="@+id/rbEye3" android:text="3 - Severe"/>
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8. Sleep Disturbance"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                    <RadioGroup
                        android:id="@+id/rgSleep"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RadioButton android:id="@+id/rbSleep0" android:text="0 - None"/>
                        <RadioButton android:id="@+id/rbSleep1" android:text="1 - Mild"/>
                        <RadioButton android:id="@+id/rbSleep2" android:text="2 - Moderate"/>
                        <RadioButton android:id="@+id/rbSleep3" android:text="3 - Severe"/>
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnSubmitSymptoms"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="@string/submit_symptom_sheet"
                android:backgroundTint="#3F51B5"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>